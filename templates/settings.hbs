<div class="wod-settings">
  <header class="wod-settings-header">
    <h2>{{localize "WOD5E_HUD.Settings.Title"}}</h2>
    <p>{{localize "WOD5E_HUD.Settings.Subtitle"}}</p>
  </header>

  <nav class="wod-settings-tabs">
    {{#each tabs}}
      <button type="button" class="wod-settings-tab" data-tab="{{this.id}}">
        <i class="{{this.icon}}"></i>
        <span>{{localize this.label}}</span>
      </button>
    {{/each}}
  </nav>

  <section class="wod-settings-panel" data-tab-panel="player">
    <div class="wod-settings-row wod-settings-row--static {{#unless canToggleCombat}}is-locked{{/unless}}">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.CombatHud"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.CombatHudHint"}}</small>
        {{#if combatLockedByForce}}
          <small class="wod-settings-lock">{{localize "WOD5E_HUD.Settings.CombatDisabledByGM"}}</small>
        {{/if}}
        {{#if combatLockedByPermission}}
          <small class="wod-settings-lock">{{localize "WOD5E_HUD.Settings.CombatControlledByGM"}}</small>
        {{/if}}
      </span>
      <div
        class="wod-scale-options"
        role="group"
        aria-label="{{localize 'WOD5E_HUD.Settings.CombatHud'}}"
      >
        <button
          type="button"
          class="wod-scale-option {{#if combatHud}}is-active{{/if}}"
          data-setting-value="combatHud"
          data-value="true"
          {{#unless canToggleCombat}}disabled{{/unless}}
        >
          {{localize "WOD5E_HUD.Settings.StateOn"}}
        </button>
        <button
          type="button"
          class="wod-scale-option {{#unless combatHud}}is-active{{/unless}}"
          data-setting-value="combatHud"
          data-value="false"
          {{#unless canToggleCombat}}disabled{{/unless}}
        >
          {{localize "WOD5E_HUD.Settings.StateOff"}}
        </button>
      </div>
    </div>

    <div class="wod-settings-row wod-settings-row--static">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.MinimalActions"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.MinimalActionsHint"}}</small>
      </span>
      <div
        class="wod-scale-options"
        role="group"
        aria-label="{{localize 'WOD5E_HUD.Settings.MinimalActions'}}"
      >
        <button
          type="button"
          class="wod-scale-option {{#if minimalActions}}is-active{{/if}}"
          data-setting-value="minimalActions"
          data-value="true"
        >
          {{localize "WOD5E_HUD.Settings.StateEnabled"}}
        </button>
        <button
          type="button"
          class="wod-scale-option {{#unless minimalActions}}is-active{{/unless}}"
          data-setting-value="minimalActions"
          data-value="false"
        >
          {{localize "WOD5E_HUD.Settings.StateDisabled"}}
        </button>
      </div>
    </div>

    <div class="wod-settings-row wod-settings-row--static">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.HideHotbar"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.HideHotbarHint"}}</small>
      </span>
      <div
        class="wod-scale-options"
        role="group"
        aria-label="{{localize 'WOD5E_HUD.Settings.HideHotbar'}}"
      >
        <button
          type="button"
          class="wod-scale-option {{#if hideHotbar}}is-active{{/if}}"
          data-setting-value="hideHotbar"
          data-value="true"
        >
          {{localize "WOD5E_HUD.Settings.StateEnabled"}}
        </button>
        <button
          type="button"
          class="wod-scale-option {{#unless hideHotbar}}is-active{{/unless}}"
          data-setting-value="hideHotbar"
          data-value="false"
        >
          {{localize "WOD5E_HUD.Settings.StateDisabled"}}
        </button>
      </div>
    </div>

    <div class="wod-settings-row wod-settings-row--static">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.UiScale"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.UiScaleHint"}}</small>
      </span>
      <div class="wod-scale-options" role="group" aria-label="{{localize 'WOD5E_HUD.Settings.UiScale'}}">
        {{#each scaleOptions}}
          <button type="button" class="wod-scale-option {{#if this.active}}is-active{{/if}}" data-scale="{{this.id}}">
            {{localize this.label}}
          </button>
        {{/each}}
      </div>
    </div>

    <button type="button" class="wod-settings-btn" data-action="reset-position">
      <i class="fa-solid fa-location-crosshairs"></i>
      {{localize "WOD5E_HUD.Settings.ResetPosition"}}
    </button>
  </section>

  {{#if isGM}}
    <section class="wod-settings-panel" data-tab-panel="gm">
      <p class="wod-settings-note">{{localize "WOD5E_HUD.Settings.GMHint"}}</p>

      <div class="wod-settings-row wod-settings-row--static">
        <span class="wod-settings-copy">
          <strong>{{localize "WOD5E_HUD.Settings.CombatForAll"}}</strong>
          <small>{{localize "WOD5E_HUD.Settings.CombatForAllHint"}}</small>
        </span>
        <div
          class="wod-scale-options"
          role="group"
          aria-label="{{localize 'WOD5E_HUD.Settings.CombatForAll'}}"
        >
          {{#each combatModeOptions}}
            <button
              type="button"
              class="wod-scale-option {{#if this.active}}is-active{{/if}}"
              data-combat-mode="{{this.id}}"
            >
              {{localize this.label}}
            </button>
          {{/each}}
        </div>
      </div>

      <div class="wod-settings-row wod-settings-row--static">
        <span class="wod-settings-copy">
          <strong>{{localize "WOD5E_HUD.Settings.AllowCombatToggle"}}</strong>
          <small>{{localize "WOD5E_HUD.Settings.AllowCombatToggleHint"}}</small>
        </span>
        <div
          class="wod-scale-options"
          role="group"
          aria-label="{{localize 'WOD5E_HUD.Settings.AllowCombatToggle'}}"
        >
          <button
            type="button"
            class="wod-scale-option {{#if allowCombatToggle}}is-active{{/if}}"
            data-world-setting-value="allowPlayerCombatToggle"
            data-value="true"
          >
            {{localize "WOD5E_HUD.Settings.StateEnabled"}}
          </button>
          <button
            type="button"
            class="wod-scale-option {{#unless allowCombatToggle}}is-active{{/unless}}"
            data-world-setting-value="allowPlayerCombatToggle"
            data-value="false"
          >
            {{localize "WOD5E_HUD.Settings.StateDisabled"}}
          </button>
        </div>
      </div>
    </section>
  {{/if}}
</div>
