<div class="wod-settings">
  <header class="wod-settings-header">
    <h2>{{localize "WOD5E_HUD.Settings.Title"}}</h2>
    <p>{{localize "WOD5E_HUD.Settings.Subtitle"}}</p>
  </header>

  <nav class="wod-settings-tabs">
    {{#each tabs}}
      <button type="button" class="wod-settings-tab" data-tab="{{this.id}}">
        <i class="{{this.icon}}"></i>
        <span>{{localize this.label}}</span>
      </button>
    {{/each}}
  </nav>

  <section class="wod-settings-panel" data-tab-panel="player">
    <label class="wod-settings-row {{#unless canToggleCombat}}is-locked{{/unless}}">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.CombatHud"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.CombatHudHint"}}</small>
        {{#if combatLockedByForce}}
          <small class="wod-settings-lock">{{localize "WOD5E_HUD.Settings.ForcedByGM"}}</small>
        {{/if}}
        {{#if combatLockedByPermission}}
          <small class="wod-settings-lock">{{localize "WOD5E_HUD.Settings.PermissionLocked"}}</small>
        {{/if}}
      </span>
      <input
        type="checkbox"
        data-setting="combatHud"
        {{#if combatHud}}checked{{/if}}
        {{#unless canToggleCombat}}disabled{{/unless}}
      >
    </label>

    <label class="wod-settings-row">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.MinimalActions"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.MinimalActionsHint"}}</small>
      </span>
      <input
        type="checkbox"
        data-setting="minimalActions"
        {{#if minimalActions}}checked{{/if}}
      >
    </label>

    <label class="wod-settings-row">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.HideHotbar"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.HideHotbarHint"}}</small>
      </span>
      <input
        type="checkbox"
        data-setting="hideHotbar"
        {{#if hideHotbar}}checked{{/if}}
      >
    </label>

    <div class="wod-settings-row wod-settings-row--static">
      <span class="wod-settings-copy">
        <strong>{{localize "WOD5E_HUD.Settings.UiScale"}}</strong>
        <small>{{localize "WOD5E_HUD.Settings.UiScaleHint"}}</small>
      </span>
      <div class="wod-scale-options" role="group" aria-label="{{localize 'WOD5E_HUD.Settings.UiScale'}}">
        {{#each scaleOptions}}
          <button type="button" class="wod-scale-option {{#if this.active}}is-active{{/if}}" data-scale="{{this.id}}">
            {{localize this.label}}
          </button>
        {{/each}}
      </div>
    </div>

    <button type="button" class="wod-settings-btn" data-action="reset-position">
      <i class="fa-solid fa-location-crosshairs"></i>
      {{localize "WOD5E_HUD.Settings.ResetPosition"}}
    </button>
  </section>

  {{#if isGM}}
    <section class="wod-settings-panel" data-tab-panel="gm">
      <p class="wod-settings-note">{{localize "WOD5E_HUD.Settings.GMHint"}}</p>

      <div class="wod-settings-row wod-settings-row--static">
        <span class="wod-settings-copy">
          <strong>{{localize "WOD5E_HUD.Settings.CombatForAll"}}</strong>
          <small>{{localize "WOD5E_HUD.Settings.CombatForAllHint"}}</small>
        </span>
        <div
          class="wod-scale-options"
          role="group"
          aria-label="{{localize 'WOD5E_HUD.Settings.CombatForAll'}}"
        >
          {{#each combatModeOptions}}
            <button
              type="button"
              class="wod-scale-option {{#if this.active}}is-active{{/if}}"
              data-combat-mode="{{this.id}}"
            >
              {{localize this.label}}
            </button>
          {{/each}}
        </div>
      </div>

      <label class="wod-settings-row">
        <span class="wod-settings-copy">
          <strong>{{localize "WOD5E_HUD.Settings.AllowCombatToggle"}}</strong>
          <small>{{localize "WOD5E_HUD.Settings.AllowCombatToggleHint"}}</small>
        </span>
        <input
          type="checkbox"
          data-world-setting="allowPlayerCombatToggle"
          {{#if allowCombatToggle}}checked{{/if}}
        >
      </label>
    </section>
  {{/if}}
</div>
